# =============================================================
# manzo-dados | Airflow - modelo de configuracao
# Copie para .env nesta mesma pasta e preencha.
#   cp .env.example .env
#
# O docker compose le este arquivo automaticamente.
# =============================================================

# --- SQL Server do host ---
# O servidor NAO se configura aqui: dentro do container e sempre
# host.docker.internal, definido no docker-compose.yml.
DB_DATABASE=db-manzo
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# --- Pastas do host montadas no container ---
# Use barra normal e aspas se houver espaco no caminho.
PATH_DADOS_HOST=C:/caminho/para/Financeiro/Dados
PATH_REPORT_HOST=C:/caminho/para/Financeiro/report

# --- Airflow ---
# Gere as chaves com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
FERNET_KEY=
WEBSERVER_SECRET_KEY=

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque_esta_senha
AIRFLOW_ADMIN_EMAIL=admin@example.com

# UID usado dentro do container. 50000 e o padrao da imagem oficial.
AIRFLOW_UID=50000

# --- Envio de e-mail -------------------------------------------------
# Senha de aplicativo do Google (myaccount.google.com/apppasswords),
# nunca a senha da conta. SMTP_PARA aceita varios, separados por virgula.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@seudominio.com.br
SMTP_PASSWORD=
SMTP_FROM=voce@seudominio.com.br
SMTP_PARA=voce@seudominio.com.br

PATH_EXAMES_HOST=C:\caminho\para\Avaliacoes

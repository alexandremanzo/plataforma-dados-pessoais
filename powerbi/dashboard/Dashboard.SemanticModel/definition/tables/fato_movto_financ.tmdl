	partition fato_movto_financ = m
		mode: import
		source =
				let
				    Origem = Sql.Database(pServidor, pBanco),
				    Tabela = Origem{[Schema="gold", Item="fato_movto_financ"]}[Data],
				
				    // Copia da gold: so a selecao das colunas que esta aba usa. Nada e
				    // transformado aqui - o que precisa ser derivado e coluna
				    // calculada, que fica visivel no modelo.
				    Final  = Table.SelectColumns(Tabela, {"SK_DATA", "SK_ORIGEM", "SK_CATEGORIA_FINANC", "SK_GRUPO_FINANC", "VL_TRANSACAO", "DS_NIVEL", "DS_TIPO_FLUXO", "NR_PARCELA", "DS_DETALHE_ORIGINAL"}, MissingField.UseNull)
				in
				    Final

	annotation PBI_ResultType = Exception


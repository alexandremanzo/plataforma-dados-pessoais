	column FL_FERIADO
		dataType: string
		lineageTag: 800b2674-b2e4-5b1d-a844-6224ed364f3e
		summarizeBy: none
		sourceColumn: FL_FERIADO

		annotation SummarizationSetBy = Automatic

	column NM_FERIADO
		dataType: string
		lineageTag: c4908ed9-e487-5714-9d28-1e33ce3f7e61
		summarizeBy: none
		sourceColumn: NM_FERIADO

		annotation SummarizationSetBy = Automatic

	/// Semana dentro do mês, 1 a 6. É a linha do calendário — não existe na gold, nasce aqui.
	column NR_SEMANA_MES =
			// A linha do calendario. WEEKDAY(_,1) devolve 1 para domingo, que e a
			// coluna em que o calendario comeca; o deslocamento empurra o dia 1
			// para a posicao certa na primeira linha.
			VAR _primeiro = DATE ( dim_calendario[NR_ANO], dim_calendario[NR_MES], 1 )
			VAR _desloc = WEEKDAY ( _primeiro, 1 ) - 1
			RETURN
			    INT ( ( dim_calendario[NR_DIA] + _desloc - 1 ) / 7 ) + 1
		dataType: int64
		formatString: 0
		lineageTag: 5a119c82-8894-5767-8ab2-8df7b4bdcb98
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = m
		mode: import
		source =
				let
				    Origem = Sql.Database(pServidor, pBanco),
				    Tabela = Origem{[Schema="gold", Item="dim_calendario"]}[Data],
				
				    // Copia da gold: so a selecao das colunas que esta aba usa. Nada e
				    // transformado aqui - o que precisa ser derivado e coluna
				    // calculada, que fica visivel no modelo.
				    Final  = Table.SelectColumns(Tabela, {"SK_DATA", "DT_DATA", "NR_ANO", "NR_MES", "NM_MES", "NM_MES_ABREV", "NM_ANO_MES", "NM_MES_ANO", "NR_DIA", "NR_DIA_SEMANA", "NM_DIA_SEMANA", "NM_DIA_SEMANA_ABREV", "FL_FIM_SEMANA", "FL_FERIADO", "NM_FERIADO"}, MissingField.UseNull)
				in
				    Final

	annotation PBI_ResultType = Exception


/// Fato: um lançamento por linha. O pagamento da fatura (SINTETICO) fica de fora para não contar o cartão duas vezes.
table Movimentacao
	lineageTag: 30ed6045-de91-539b-b857-6a4685863a1b

	column SK_DATA
		dataType: int64
		isHidden
		lineageTag: 4b8ca811-7d22-5bec-9fa7-52a38ec9acf0
		summarizeBy: none
		sourceColumn: SK_DATA

		annotation SummarizationSetBy = Automatic

	column SK_ORIGEM
		dataType: int64
		isHidden
		lineageTag: 1fe5a22a-c0a3-5e1d-a1b5-6164399e61c5
		summarizeBy: none
		sourceColumn: SK_ORIGEM

		annotation SummarizationSetBy = Automatic


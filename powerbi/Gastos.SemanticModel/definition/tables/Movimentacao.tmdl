/// Fato: um lançamento por linha. SINTETICO (pagamento de fatura) fica de fora para não contar o cartão duas vezes.
table Movimentacao
	lineageTag: 30ed6045-de91-539b-b857-6a4685863a1b

	column SK_DATA
		dataType: int64
		isHidden
		lineageTag: 4b8ca811-7d22-5bec-9fa7-52a38ec9acf0
		summarizeBy: none
		sourceColumn: SK_DATA

		annotation SummarizationSetBy = Automatic

	column SK_DATA_FATURA
		dataType: int64
		isHidden
		lineageTag: 4366ca9b-3442-5d1f-b8a8-fba45f58a53b
		summarizeBy: none
		sourceColumn: SK_DATA_FATURA

		annotation SummarizationSetBy = Automatic

	column SK_ORIGEM
		dataType: int64
		isHidden
		lineageTag: 1fe5a22a-c0a3-5e1d-a1b5-6164399e61c5

# =============================================================
# manzo-dados - Modelo de configuracao
# Copie para .env e preencha com os valores reais.
#   cp .env.example .env
# =============================================================

# --- Conexao SQL Server ---
DB_SERVER=localhost
DB_DATABASE=db-manzo
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticacao: "sql" (usuario/senha) ou "windows" (trusted connection)
DB_AUTH=sql
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Confia no certificado do servidor (necessario em instancia local sem cert)
DB_TRUST_CERT=yes
DB_TIMEOUT=30

# --- Caminhos de origem dos dados ---
PATH_DADOS_ORIGEM=C:\caminho\para\os\arquivos
PATH_REPORT=C:\caminho\para\os\relatorios
# Planilhas nao financeiras (avaliacao fisica e futuras bases de saude)
PATH_PLANILHAS=C:\caminho\para\as\planilhas

# --- Origens Google Sheets ---
# Publique a aba desejada em Arquivo > Compartilhar > Publicar na web,
# no formato CSV, e cole aqui a URL gerada (contem /d/e/2PACX-).
# Conta familia: gastos em comum de Ale e Lia.
PLANILHA_FAMILIA_URL=
# Meu dia: respostas do Google Forms com o diario de habitos.
PLANILHA_DIA_URL=
# --- Envio de e-mail -------------------------------------------------
# Senha de aplicativo do Google (myaccount.google.com/apppasswords),
# nunca a senha da conta. SMTP_PARA aceita varios, separados por virgula.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@seudominio.com.br
SMTP_PASSWORD=
SMTP_FROM=voce@seudominio.com.br
SMTP_PARA=voce@seudominio.com.br

# Pasta dos exames de bioimpedancia (imagens InBody)
PATH_EXAMES=C:\caminho\para\Avaliacoes

# --- Pluggy: investimentos da XP via Open Finance --------------------
# A XP nao tem API para pessoa fisica. O caminho e um agregador de Open
# Finance, e o "Meu Pluggy" e gratuito para ate 5 conexoes do proprio
# titular (meu.pluggy.ai). As duas chaves saem de dashboard.pluggy.ai,
# aba Aplicacao, depois de criar a aplicacao e o conector "MeuPluggy".
#
# ATENCAO: o consentimento de Open Finance VENCE (12 meses) e precisa
# ser renovado. Quando vence, a carga para - e para em silencio.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional: so se houver mais de uma conexao na aplicacao.
PLUGGY_ITEM_ID=
